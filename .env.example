# Salin berkas ini menjadi `.env`, lalu isi dengan nilai proyek Supabase Anda.
# Nilai asli TIDAK pernah dikomit ke git.
#
# Ambil kedua nilai di: Supabase Dashboard → Project Settings → API
#
# PERINGATAN: hanya `anon key` (publishable) yang boleh ada di sini.
# `service_role key` tidak pernah masuk ke kode frontend dalam bentuk apa pun.
# Keamanan data dijaga oleh RLS di database, bukan oleh menyembunyikan kunci.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-key
